# ==============================================
# Application Server Configuration
# ==============================================
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================
# Database Configuration (PostgreSQL / MySQL)
# ==============================================
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password
DATABASE_NAME=ecommerce_db
DATABASE_HOST=localhost
# Connection string (e.g., Prisma / TypeORM)
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/ecommerce_db?schema=public

# ==============================================
# JWT Authentication
# ==============================================
JWT_SECRET=your_super_secret_access_token_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================
# Stripe Payment Gateway
# ==============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
